{
    "name": "synthetic-companies-resolve-found",
    "description": "A domain resolved to the company's name, LinkedIn page and logo. Synthetic, shaped on Fuse's published Business API contract (2026-10-29).",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 200,
                "body": {
                    "status": "found",
                    "company": {
                        "name": "Northwind Payments",
                        "domain": "northwind-payments.example",
                        "linkedinUrl": "linkedin.com/company/northwind-payments",
                        "logoUrl": "https://logos.northwind-payments.example/mark.png"
                    },
                    "creditsCharged": 0
                }
            }
        }
    ]
}
