{
    "name": "synthetic-companies-search",
    "description": "A query search answering one page of two companies and a nextCursor. Each row carries Fuse's workspace `isSaved`, which the endpoint drops; the answer carries no receipt, so the rows returned are what is billed. Synthetic, shaped on Fuse's published Business API contract (2026-10-29).",
    "calls": [
        {
            "req": {
                "method": "POST",
                "url": "{{request.url}}"
            },
            "res": {
                "status": 200,
                "body": {
                    "companies": [
                        {
                            "isSaved": false,
                            "preferred_name": "Northwind Payments",
                            "domains": [
                                "northwind-payments.example"
                            ],
                            "linkedin_primary_slug": "northwind-payments",
                            "standard_industries": [
                                "financial services"
                            ],
                            "funding_stage": "series_b",
                            "employee_count_consensus": {
                                "gte": 51,
                                "lte": 200
                            }
                        },
                        {
                            "isSaved": false,
                            "preferred_name": "Ledgerline",
                            "domains": [
                                "ledgerline.example"
                            ],
                            "linkedin_primary_slug": "ledgerline",
                            "standard_industries": [
                                "financial services"
                            ],
                            "funding_stage": "series_b",
                            "employee_count_consensus": {
                                "gte": 51,
                                "lte": 200
                            }
                        }
                    ],
                    "total": 1287,
                    "nextCursor": "c_synthetic_page_2",
                    "filters": {
                        "crunchbaseCategoryGroups": [
                            "Financial Services"
                        ],
                        "stage": [
                            {
                                "label": "Series B",
                                "value": "series_b",
                                "status": "include"
                            }
                        ],
                        "headquartersCity": [
                            "New York, New York, United States"
                        ],
                        "employeeCountV2": {
                            "min": 50,
                            "max": 200
                        }
                    },
                    "unresolvedCriteria": []
                }
            }
        }
    ]
}
